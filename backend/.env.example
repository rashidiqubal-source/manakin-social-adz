# Backend Environment Configuration
PROJECT_NAME="Social Adz API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite+aiosqlite:///./socialadz.db"

# OAuth Application Credentials
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

SNAP_CLIENT_ID="your_snap_client_id"
SNAP_CLIENT_SECRET="your_snap_client_secret"

TWITTER_CLIENT_ID="your_twitter_client_id"
TWITTER_CLIENT_SECRET="your_twitter_client_secret"
